{
  "name": "shadowfence",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests scripts *.json *.ts *.html",
    "test": "vitest run",
    "build": "node scripts/notices.mjs && vite build && node scripts/validate-package.mjs",
    "test:browser": "node tests/migration-browser.mjs && node tests/browser.mjs && node tests/store-screenshots.mjs",
    "package": "node scripts/package.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "esbuild": "npm:esbuild-wasm@^0.28.2",
    "rollup": "npm:@rollup/wasm-node@^4.65.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "npm:esbuild-wasm@^0.28.2",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.4",
    "fflate": "^0.8.2",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "rollup": "npm:@rollup/wasm-node@^4.65.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.5"
  }
}
